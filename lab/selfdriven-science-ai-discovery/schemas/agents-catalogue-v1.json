{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selfdriven.science/schemas/agents-catalogue-v1.json",
  "title": "SelfDriven Science AI Resource Catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "name",
    "canonical_url",
    "publisher",
    "resources",
    "a2a"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_version": { "type": "string" },
    "kind": { "const": "ai-resource-catalogue" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "canonical_url": { "type": "string", "format": "uri" },
    "publisher": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "discovery": { "type": "object" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "version",
          "description",
          "canonical_url",
          "media_type",
          "protocol",
          "capabilities"
        ],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "status": { "type": "string" },
          "description": { "type": "string" },
          "canonical_url": { "type": "string", "format": "uri" },
          "media_type": { "type": "string" },
          "protocol": { "type": "string" },
          "interactive_endpoint": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "invocation": { "type": "object" },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "references": {
            "type": "array",
            "items": { "type": "object" }
          },
          "scientific_posture": { "type": "object" },
          "license": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "a2a": {
      "type": "object",
      "required": ["available", "agent_card"],
      "properties": {
        "available": { "type": "boolean" },
        "agent_card": { "type": ["string", "null"], "format": "uri" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
